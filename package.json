{
  "name": "example-bot",
  "main": "dist/main.js",
  "type": "module",
  "engineStrict": true,
  "devDependencies": {
    "@eslint/compat": "^1.2.0",
    "@types/lodash": "^4.17.10",
    "@types/node": "^20.16.12",
    "@typescript-eslint/parser": "^8.9.0",
    "discord-api-types": "^0.37.102",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3"
  },
  "peerDependencies": {
    "typescript": "^5.5.2"
  },
  "dependencies": {
    "@google/generative-ai": "^0.19.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "lodash": "^4.17.21",
    "mocha": "^10.7.3",
    "osu-web.js": "^2.5.0"
  },
  "scripts": {
    "start": "rm -rf dist && tsc && bun .",
    "build": "rm -rf dist && tsc",
    "rmcache": "rm -rf node_modules/.cache && rm -rf dist",
    "lint": "eslint",
    "watch": "tsc -w",
    "buildWatch": "tsc && tsc -w",
    "debug": "bun --inspect --hot .",
    "fmt": "bun x prettier --write .",
    "test": "bun x mocha",
    "gpg:agent": "gpg-connect-agent reloadagent /bye"
  }
